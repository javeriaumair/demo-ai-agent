# LikhoAI environment variables.
# Local: copy this file to .env.local and fill in the values (never commit .env.local).
# Vercel: add the same names in Project → Settings → Environment Variables.

# ---------- Required ----------

# Google Gemini API key — get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------- Daily limit storage (needed in production) ----------
# Upstash Redis keeps the "5 articles per day" count. If these are empty,
# the app falls back to server memory (fine on your laptop, not on Vercel).
#
# Option A — Vercel Marketplace "Upstash for Redis" integration adds these automatically:
KV_REST_API_URL=
KV_REST_API_TOKEN=
#
# Option B — database created directly on upstash.com (REST API section):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
#
# You only need ONE of the two options.

# ---------- Optional ----------

# Gemini models to try, in order (default: gemini-3.6-flash,gemini-3.5-flash-lite)
GEMINI_MODEL=

# Articles per visitor per day (default: 5)
DAILY_GENERATION_LIMIT=
